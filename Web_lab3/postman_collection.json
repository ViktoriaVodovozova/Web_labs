              "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);",
              "pm.test('ADMIN', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Создание студента",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Иван Иванов\",\n  \"group\": \"P3121\",\n  \"isuId\": \"{{isuId}}\",\n  \"dormitory\": 1,\n  \"room\": 205,\n  \"moveInDate\": \"2026-09-01\",\n  \"isForeigner\": false,\n  \"notes\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('studentId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Список, поиск, фильтры, сортировка и пагинация",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/requests?search={{isuId}}&group=P3121&dormitory=1&isForeigner=false&page=0&size=10&sortBy=room&direction=desc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Есть результаты', () => pm.expect(pm.response.json()).to.have.lengthOf(1));",
              "pm.test('Есть число записей', () => pm.expect(pm.response.headers.get('X-Total-Count')).to.eql('1'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Карточка студента",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
